{
	"name": "rilog-frontend",
	"version": "0.1.0",
	"private": true,
	"type": "module",
	"scripts": {
		"dev": "next dev",
		"build": "next build",
		"start": "next start",
		"lint": "eslint",
		"format": "prettier --write .",
		"format:check": "prettier --check .",
		"typecheck": "next typegen && tsc --noEmit",
		"test:unit": "vitest run --config vitest-unit.config.ts",
		"test:component": "vitest run --config vitest-component.config.ts",
		"test:e2e": "playwright test --config playwright.config.ts",
		"check": "pnpm format:check && pnpm lint && pnpm typecheck && pnpm test:unit && pnpm test:component && pnpm build"
	},
	"dependencies": {
		"@blocknote/code-block": "0.53.0",
		"@blocknote/core": "0.53.0",
		"@blocknote/react": "0.53.0",
		"@blocknote/server-util": "0.53.0",
		"@blocknote/shadcn": "0.53.0",
		"@tanstack/react-query": "5.101.4",
		"ky": "2.0.2",
		"next": "16.3.0",
		"posthog-js": "1.418.10",
		"react": "19.2.8",
		"react-dom": "19.2.8",
		"shiki": "4.4.3",
		"y-prosemirror": "1.3.7"
	},
	"devDependencies": {
		"@playwright/test": "1.62.1",
		"@svgr/webpack": "8.1.0",
		"@tailwindcss/postcss": "4.3.3",
		"@testing-library/jest-dom": "7.0.0",
		"@testing-library/react": "16.3.2",
		"@testing-library/user-event": "14.6.3",
		"@types/node": "24.13.3",
		"@types/react": "19.2.18",
		"@types/react-dom": "19.2.4",
		"@vitejs/plugin-react": "6.0.5",
		"eslint": "9.39.5",
		"eslint-config-next": "16.3.0",
		"eslint-config-prettier": "10.1.8",
		"eslint-plugin-check-file": "3.3.2",
		"eslint-plugin-import": "2.32.0",
		"eslint-plugin-unused-imports": "4.4.1",
		"jsdom": "30.0.1",
		"prettier": "3.9.6",
		"prettier-plugin-tailwindcss": "0.8.1",
		"tailwindcss": "4.3.3",
		"typescript": "5.9.3",
		"typescript-eslint": "8.66.0",
		"vite-plugin-svgr": "5.2.0",
		"vitest": "4.1.10"
	},
	"packageManager": "pnpm@11.21.0",
	"engines": {
		"node": "24.19.0",
		"pnpm": "11.21.0"
	}
}
