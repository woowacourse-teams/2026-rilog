NEXT_PUBLIC_API_BASE_URL=
NEXT_PUBLIC_SITE_URL=https://www.rilog.kr
NEXT_PUBLIC_DEV_MASTER_TOKEN=
NEXT_PUBLIC_S3_BUCKET_URL=

# PostHog
NEXT_PUBLIC_POSTHOG_PROJECT_TOKEN=your_posthog_project_token
NEXT_PUBLIC_POSTHOG_HOST=your_posthog_host

# Sentry
SENTRY_AUTH_TOKEN=
NEXT_PUBLIC_SENTRY_DSN=
NEXT_PUBLIC_SENTRY_ENABLED=false
# Slack 알림은 서버에서 검증한 Sentry webhook으로만 전달한다.
# 로컬 기본값은 off. 운영에서는 webhook과 아래 필수 설정을 함께 적용한다.
SENTRY_SLACK_MODE=off
SENTRY_WEBHOOK_CLIENT_SECRET=
SENTRY_WEBHOOK_PROJECT_ID=
SENTRY_WEBHOOK_ORG=rilog-frontend
SENTRY_WEBHOOK_ENVIRONMENT=prod
SENTRY_SLACK_STATE_DIR=
SENTRY_SLACK_WEBHOOK_URL=
SENTRY_SLACK_BOT_TOKEN=
SENTRY_SLACK_CHANNEL_ID=

# 로컬 환경에서 Sentry를 테스트할 때 아래 스크립트로 실행하세요
# NEXT_PUBLIC_SENTRY_ENABLED=true pnpm dev
