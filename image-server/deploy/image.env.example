AWS_REGION=ap-northeast-2
S3_BUCKET=replace-with-rilog-bucket
# Existing image delivery origin (S3/CloudFront). Not the import API domain.
IMAGE_BASE_URL=https://images.example.com
# Same value as the backend AWS_S3_DIRECTORY. Objects go to {root}/{images|profiles}/raw/{userId}-{UUID}/original.webp
S3_ROOT_DIRECTORY=replace-with-backend-aws-s3-directory
