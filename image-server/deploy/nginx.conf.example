# Host Ubuntu Nginx: install this file in /etc/nginx/sites-available/image.rilog.kr
# limit_req_zone belongs to the http context (sites-enabled is included there).
# Only the Rilog backend calls the import API (HMAC signed), so there is no browser CORS.
limit_req_zone $binary_remote_addr zone=rilog_image_import:1m rate=30r/m;

server {
    listen 80;
    server_name image.rilog.kr;
    client_max_body_size 8k;

    location = /healthz {
        proxy_pass http://127.0.0.1:8000;
        access_log off;
    }

    location = /api/images/import {
        limit_req zone=rilog_image_import burst=5 nodelay;
        limit_req_status 429;
        proxy_pass http://127.0.0.1:8000;
        proxy_http_version 1.1;
        proxy_set_header Connection "";
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $remote_addr;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_connect_timeout 3s;
        proxy_read_timeout 60s;
    }
    location / { return 404; }
}
